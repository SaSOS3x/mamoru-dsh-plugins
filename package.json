{
  "name": "mamoru-dsh-plugins",
  "version": "1.2.0",
  "description": "Mamoru skills for DeepSeek Harness: core and minecraft components plus two agent presets (mamoru-work, mamoru-minecraft-work).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./minecraft": "./lib/minecraft.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "docs/PORTING.md",
    "install.ps1",
    "check_skills.py",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skills",
    "minecraft",
    "neoforge",
    "kubejs",
    "windows"
  ]
}
