{
  "name": "mamoru-dsh-plugins",
  "version": "1.0.0",
  "description": "Mamoru's skills for DeepSeek Harness: project journal, agent delegation, session error audit, skill forge, test mutations, Minecraft NeoForge 1.21.1, Windows shell traps and readable documents.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "skills",
    "docs/PORTING.md",
    "install.ps1",
    "check_skills.py",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skills",
    "minecraft",
    "neoforge",
    "kubejs",
    "windows"
  ]
}
